  },
  "required_item_params": ["item_id", "item_name", "price", "quantity"],
  "event_param_types": {
    "currency": "string", "value": "number", "item_list_id": "string", "item_list_name": "string",
    "coupon": "string", "shipping_tier": "string", "payment_type": "string", "transaction_id": "string",
    "tax": "number", "shipping": "number", "customer_type": "string", "creative_name": "string",
