  },
  "events": [
    {"event_name": "view_item_list", "user_action": "User is presented with a list of results/products", "event_params": ["currency", "item_list_id", "item_list_name"], "min_items": 1},
    {"event_name": "select_item", "user_action": "User selects an item from a list", "event_params": ["currency", "item_list_id", "item_list_name"], "min_items": 1},
    {"event_name": "view_item", "user_action": "User views an item's detail screen", "event_params": ["currency", "value"], "min_items": 1},
