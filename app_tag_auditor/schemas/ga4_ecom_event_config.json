    {"event_name": "add_payment_info", "user_action": "User submits payment information", "event_params": ["currency", "value", "coupon", "payment_type"], "min_items": 1},
    {"event_name": "purchase", "user_action": "User completes checkout and payment succeeds", "event_params": ["transaction_id", "value", "tax", "shipping", "currency", "coupon", "customer_type"], "min_items": 1},
    {"event_name": "refund", "user_action": "User's order is refunded", "event_params": ["currency", "transaction_id", "value", "coupon", "shipping", "tax"], "min_items": 1},
    {"event_name": "view_promotion", "user_action": "User is shown an internal promotion (e.g. a banner)", "event_params": ["currency", "creative_name", "creative_slot", "promotion_id", "promotion_name"], "min_items": 1},
    {"event_name": "select_promotion", "user_action": "User clicks/taps an internal promotion", "event_params": ["currency", "creative_name", "creative_slot", "promotion_id", "promotion_name"], "min_items": 1}
  ]
