{
  "name": "app-tag-auditor-desktop",
  "version": "1.0.0",
  "description": "App Tag Auditor Desktop App Shell",
  "author": "Tatvic Analyst <analyst@tatvic.com>",
  "homepage": "https://github.com/tatvic/app-tag-auditor",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "cd renderer && npm run build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:main": "tsc -p tsconfig.json && electron dist/main.js",
    "dev": "concurrently \"cd renderer && npm run dev\" \"wait-on http://localhost:3000 && npm run dev:main\"",
    "package": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux",
    "package:win": "npm run build && electron-builder --windows"
  },
  "build": {
    "appId": "com.jotarostrategy.apptagauditor",
    "productName": "AppTagAuditor",
    "directories": {
      "output": "dist-packaged"
    },
    "asar": false,
    "files": [
      "dist/**/*",
      "renderer/out/**/*",
      { "from": "../agents", "to": "agents" },
      { "from": "../core", "to": "core" },
      { "from": "../frontend", "to": "frontend" },
      { "from": "../schemas", "to": "schemas" },
      { "from": "..", "to": ".", "filter": ["requirements.txt", "orchestrator.py", ".env", "client_secrets.json"] }
    ],
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Development"
    },
    "deb": {
      "depends": [
        "python3",
        "python3-pip",
        "python3-venv",
        "openjdk-17-jre-headless",
        "android-tools-adb",
        "udev",
        "nodejs",
        "npm",
        "curl",
        "wget",
        "unzip"
      ],
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "App Tag Auditor",
      "include": "build/windows-setup.nsh",
      "uninstallDisplayName": "App Tag Auditor"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  }
}
